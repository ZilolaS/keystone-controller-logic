{
  "version": "2",
  "device": {
    "vendor": "OLiPower",
    "model": "Omni BL 290 TMU (liquid cooling) template",
    "protocol": "modbus-tcp",
    "name": "eSpire290_OLP_TMU",
    "sourceFormat": "json-offset-template",
    "defaultByteOrder": "BE",
    "defaultWordOrder32": "ABCD",
    "notes": "Addresses are offsets from the TMU base. Runtime base = 33162 + tmuIndex * 28 (TMU 1 = index 0). Instantiate with buildEspire290TmuTemplate()."
  },
