      "category": "Status",
      "pollClass": "normal",
      "function": "IRUS",
      "address": 0,
      "confidence": "high",
      "enumStatus": {
        "0": "Idle",
        "1": "Inner loop",
        "2": "Cooling",
        "3": "Heating",
        "4": "Auto"
