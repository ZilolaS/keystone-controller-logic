    {
      "id": "cabinetGatewayFaultWord",
      "description": "Calculated cloud-safe SS50K cabinet gateway fault word",
      "pollClass": "normal",
      "calc": {
        "inputs": {
          "summary": "GatewaySummaryWord",
          "pcs1": "GatewayPcs1SummaryWord",
          "pcs2": "GatewayPcs2SummaryWord",
          "air1": "GatewayAirConditioner1SummaryWord",
          "dry": "GatewayDryContactSummaryWord",
          "bms1": "GatewayBms1SummaryWord",
          "bms2": "GatewayBms2SummaryWord",
          "airStatus": "GatewayAirConditionerStatusWord",
          "singleFire": "CabinetSingleFireAlarm",
          "compositeFire": "CabinetCompositeFireAlarm",
          "smokeGas": "CabinetSmokeOrGasAlarm",
          "epo": "CabinetEpoFault",
          "transformerTemp": "CabinetTransformerOverTempFault"
        },
        "expr": "((bit(summary, 0)) << 0) | ((bit(pcs1, 1)) << 1) | ((bit(pcs2, 1)) << 2) | ((bit(air1, 1)) << 3) | ((bit(dry, 1)) << 4) | ((bit(bms1, 1)) << 5) | ((bit(bms2, 1)) << 6) | ((bit(airStatus, 1)) << 7) | (((singleFire ? 1 : 0)) << 8) | (((compositeFire ? 1 : 0)) << 9) | (((smokeGas ? 1 : 0)) << 10) | (((epo ? 1 : 0)) << 11) | (((transformerTemp ? 1 : 0)) << 12)"
      },
      "alarm": true,
      "bitfieldStatus": {
        "0": "Cabinet summary fault",
        "1": "PCS 1 total fault reported by cabinet gateway",
        "2": "PCS 2 total fault reported by cabinet gateway",
        "3": "Air conditioner 1 total fault reported by cabinet gateway",
        "4": "Cabinet dry-contact total fault",
        "5": "BMS 1 total fault reported by cabinet gateway",
        "6": "BMS 2 total fault reported by cabinet gateway",
        "7": "Air conditioner total fault",
        "8": "Cabinet single fire alarm",
        "9": "Cabinet composite fire alarm",
        "10": "Cabinet smoke or excess gas alarm",
        "11": "Cabinet EPO",
        "12": "Cabinet transformer overtemperature"
      },
      "ss40k": {
        "name": "cabinetGatewayFaultWord",
        "model": "50103"
      }
    },
    {
      "id": "cabinetGatewayWarningWord",
      "description": "Calculated cloud-safe SS50K cabinet gateway warning word",
      "pollClass": "normal",
      "calc": {
        "inputs": {
          "summary": "GatewaySummaryWord",
          "pcs1": "GatewayPcs1SummaryWord",
          "pcs2": "GatewayPcs2SummaryWord",
          "air1": "GatewayAirConditioner1SummaryWord",
          "dry": "GatewayDryContactSummaryWord",
          "bms1": "GatewayBms1SummaryWord",
          "bms2": "GatewayBms2SummaryWord",
          "airStatus": "GatewayAirConditionerStatusWord",
          "fireControl": "CabinetFireControlFault",
          "door": "CabinetDoorAlarm"
        },
        "expr": "((bit(summary, 1)) << 0) | ((bit(pcs1, 2)) << 1) | ((bit(pcs2, 2)) << 2) | ((bit(air1, 2)) << 3) | ((bit(dry, 2)) << 4) | ((bit(bms1, 2)) << 5) | ((bit(bms2, 2)) << 6) | ((bit(airStatus, 2)) << 7) | (((fireControl ? 1 : 0)) << 8) | (((door ? 1 : 0)) << 9)"
      },
      "alarm": true,
      "bitfieldStatus": {
        "0": "Cabinet summary alarm",
        "1": "PCS 1 total alarm reported by cabinet gateway",
        "2": "PCS 2 total alarm reported by cabinet gateway",
        "3": "Air conditioner 1 total alarm reported by cabinet gateway",
        "4": "Cabinet dry-contact total alarm",
        "5": "BMS 1 total alarm reported by cabinet gateway",
        "6": "BMS 2 total alarm reported by cabinet gateway",
        "7": "Air conditioner total alarm",
        "8": "Cabinet fire control fault",
        "9": "Cabinet door alarm"
      },
      "ss40k": {
        "name": "cabinetGatewayWarningWord",
        "model": "50103"
      }
    }
