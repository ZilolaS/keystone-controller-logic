    "signals": {
      "gridPowerKw": {
        "expr": "Meter.Utility_Active_Power"
      },
      "utilityPowerKw": {
        "expr": "Meter.Utility_Active_Power"
      },
      "loadPowerKw": {
        "expr": "Meter.Utility_Active_Power + Meter.AC_PV_Power - PCS.ACBusTotalActivePower"
      },
      "siteLoadKw": {
        "expr": "Meter.Utility_Active_Power + Meter.AC_PV_Power - PCS.ACBusTotalActivePower"
      },
      "pvPowerKw": {
        "expr": "PVDC1.PVSideTotalPower + PVDC2.PVSideTotalPower + Meter.AC_PV_Power"
      },
      "pvKw": {
        "expr": "PVDC1.PVSideTotalPower + PVDC2.PVSideTotalPower"
      },
      "pcsPowerKw": {
        "expr": "PCS.ACBusTotalActivePower",
        "invertSign": true
      },
      "pcsActivePowerKw": {
        "expr": "PCS.ACBusTotalActivePower",
        "invertSign": true
      },
      "batteryPowerKw": {
        "expr": "AMPACE.BamsPower"
      }
    },
    "ss40k": {
      "pPvTotal": {
        "expr": "PVDC1.PVSideTotalPower + PVDC2.PVSideTotalPower"
      },
      "pAcCplTot": {
        "expr": "Meter.AC_PV_Power"
      },
      "pLoad": {
        "expr": "Meter.Utility_Active_Power + Meter.AC_PV_Power - PCS.ACBusTotalActivePower"
      },
      "pGridImpTot": {
        "expr": "max(Meter.Utility_Active_Power, 0)"
      },
      "pGridExpTot": {
        "expr": "max(-Meter.Utility_Active_Power, 0)"
      },
      "pBatDischg": {
        "expr": "max(AMPACE.BamsPower, 0)"
      },
      "pBatChg": {
        "expr": "max(-AMPACE.BamsPower, 0)"
      },
      "socBat": {
        "expr": "AMPACE.BamsSoc * 100"
      },
      "vBat": {
        "expr": "AMPACE.BamsVoltage"
      },
      "vBatCellMax": {
        "expr": "AMPACE.BamsMaxCellVol * 1000"
      },
      "vBatCellMin": {
        "expr": "AMPACE.BamsMinCellVol * 1000"
      },
      "tempBatCellMax": {
        "expr": "AMPACE.BamsMaxCellT * 10"
      },
      "tempBatCellMin": {
        "expr": "AMPACE.BamsMinCellT * 10"
      },
      "fGrid": {
        "expr": "Meter.Utility_L1_Frequency"
      },
      "vGridL1N": {
        "expr": "Meter.Utility_L1_Voltage"
      },
      "vGridL2N": {
        "expr": "Meter.Utility_L2_Voltage"
      },
      "vGridL3N": {
        "expr": "Meter.Utility_L3_Voltage"
      }
    },
